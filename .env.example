# Configuration OpenRouter
# Copiez ce fichier en .env et remplissez les valeurs

OPENROUTER_API_KEY=sk-or-votre-cle-api-ici
DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct
CHUNK_SIZE_TOKENS=12000
CHUNK_OVERLAP_TOKENS=1200

# Optionnel : clé OpenAI pour utiliser l'API Whisper (plus rapide que le modèle local)
# Sans cette clé, le modèle Whisper local (openai-whisper) sera utilisé à la place
OPENAI_API_KEY=

# Taille du modèle Whisper local : tiny | base | small | medium | large
# base = bon compromis vitesse/qualité (défaut)
WHISPER_MODEL=base